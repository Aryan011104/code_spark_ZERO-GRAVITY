# Database Settings
# Primary: PostgreSQL with pgvector
# Fallback (Auto-detected): sqlite+aiosqlite:///backend/agri_advisory.db
DATABASE_URL=postgresql+asyncpg://agri_user:agri_password@localhost:5432/agri_advisory_db
USE_PGVECTOR=true

# Open-Meteo Weather API (Free open-access API, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Telephony Integration (Twilio / Africa's Talking)
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=AC_TEST_ACCOUNT_SID_EXAMPLE
TELEPHONY_AUTH_TOKEN=test_telephony_secret_token_2026
TELEPHONY_PHONE_NUMBER=+18005550199
TELEPHONY_WEBHOOK_URL=http://localhost:8000/api/v1/telephony/webhook

# Multilingual Speech Service
DEFAULT_LANGUAGE=hi
SUPPORTED_LANGUAGES=hi,en,sw,am,ha
